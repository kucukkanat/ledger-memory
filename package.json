{
  "name": "ledger-memory",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test packages/*/src",
    "test:e2e": "bun test e2e",
    "typecheck": "tsc --build --force",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build": "bun run --filter '@ledger/ui' build",
    "build:skill": "bun run build && bun run scripts/build-skill.ts",
    "demo": "bun run scripts/demo-seed.ts",
    "dev": "bun run packages/cli/src/bin.ts serve",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@changesets/cli": "^2.29.9",
    "@ledger/core": "workspace:*",
    "@ledger/server": "workspace:*",
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kucukkanat/ledger-memory.git"
  },
  "homepage": "https://kucukkanat.github.io/ledger-memory/"
}
